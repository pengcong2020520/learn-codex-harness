{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/studio/project.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
