{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/studio/package-check.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "path": {
      "type": "string",
      "pattern": "^outputs/design/[a-z][a-z0-9-]{0,47}/package-v[1-9][0-9]*$"
    },
    "ok": {
      "type": "boolean"
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "const": "error"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "code",
          "file",
          "reason",
          "fix"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "unverified"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "path",
    "ok",
    "errors",
    "issues",
    "status",
    "reason"
  ],
  "additionalProperties": false
}
