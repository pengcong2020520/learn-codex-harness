{
  "name": "codex-app-server-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node client/main.mjs",
    "chat": "node client/main.mjs",
    "server": "node server/main.mjs",
    "app-server": "node server/main.mjs",
    "demo": "node 05-app-server.mjs",
    "check": "node server/check.mjs",
    "check:server": "node server/check.mjs --codex",
    "smoke": "node scripts/smoke.mjs",
    "tools": "node server/modules/tools/web-cli.mjs",
    "test:codex-tools": "node --test tests/codex-tools.integration.mjs",
    "test:codex-memory": "node --test tests/codex-memory.integration.mjs",
    "data:migrate": "node scripts/data.mjs migrate",
    "data:import": "node scripts/data.mjs import",
    "data:check": "node scripts/data.mjs check",
    "test:data": "node scripts/test-data.mjs",
    "test": "node --test 05-app-server.test.mjs tests/*.test.mjs",
    "knowledge": "node scripts/knowledge.mjs",
    "knowledge:init": "node scripts/knowledge.mjs init",
    "test:rag": "node scripts/test-data.mjs --rag",
    "web": "node web/server.mjs",
    "test:web": "node --test web/tests/*.test.mjs",
    "course:build": "node web/build-curriculum.mjs",
    "course:check": "node web/build-curriculum.mjs --check",
    "agent:init": "node scripts/init-agent.mjs",
    "test:protocol": "node --test tests/protocol.integration.mjs",
    "smoke:real": "node scripts/test-data.mjs --real-smoke",
    "sessions:upgrade": "node scripts/upgrade-sessions.mjs",
    "test:protocol:research": "node scripts/test-research-protocol.mjs",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose stop postgres redis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.154.0",
    "ajv": "8.20.0",
    "htmlparser2": "12.0.0",
    "pg": "8.23.1",
    "redis": "6.3.0"
  },
  "optionalDependencies": {
    "chromadb": "3.5.0"
  }
}
