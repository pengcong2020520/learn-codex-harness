# learn-codex-harness：全部服务在 Docker 里（compose.yaml），这个单元只负责开机拉起、关机停止。
# 要启动哪些可选服务（智能体与工作台、本地向量模型）由 .env 的 COMPOSE_PROFILES 决定；数据在 Docker 数据卷与 .data/ 里，停止不会删除。
[Unit]
Description=learn-codex-harness（Docker：数据库、Redis、模型网关、Ollama、智能体服务、工作台）
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/learn-codex-harness/app
ExecStart=/usr/bin/docker compose up -d --wait
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
