# 复制为 .env 后填写；真实密钥不放入代码或模型目录。
# 本文件只由服务端读取。客户端连接信息由服务端生成，不使用模型密钥。
# 本机 Agent 服务端口（可选，默认 4317）；不监听公网。
AGENT_PORT=4317
# 产品业务存储；不传给 Codex 或模型。需要先创建数据库再运行 data:migrate。
# 用 Docker（npm run db:up）时，compose 会读取这里的 AGENT_DB_PASSWORD 和端口；本机端口被占用时改 AGENT_PG_PORT / AGENT_REDIS_PORT。
# AGENT_DB_PASSWORD=change-me
# AGENT_PG_PORT=5432
# AGENT_REDIS_PORT=6379
DATABASE_URL=postgresql://agent:change-me@127.0.0.1:5432/agent
REDIS_URL=redis://127.0.0.1:6379/0
# 默认读取 config/runtime/project.json；需要覆盖时设置相对服务根的定义路径。
# AGENT_DEFINITION=agents/writing-agent.json

# 原生记忆：默认关闭。启动类配置修改后需要重启服务。
# 开启会将符合条件的历史发送给模型提炼，不等于已成功生成摘要。
# 当前禁用原生写工具，合并链路尚有权限限制；/memory 会报告实际状态。
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_USE=true
# 控制原生后台生成；Agent 的 use/contribute 策略在 agents/writing-agent.json。
# contribute=false 不取消已经运行的后台任务，不删除旧记忆。
AGENT_MEMORY_GENERATE=true
# 留空时显式采用 CODEX_MODEL；可分别指定同一 provider 中的其他模型。
AGENT_MEMORY_EXTRACT_MODEL=
AGENT_MEMORY_CONSOLIDATION_MODEL=
# 单位小时，Codex 0.154.0 最小 1 小时；不是定时任务的执行间隔。
AGENT_MEMORY_MIN_IDLE_HOURS=6

CODEX_API_KEY=
CODEX_BASE_URL=https://api.deepseek.com
CODEX_MODEL=deepseek-flash

# 以下参数由主程序转换为本次运行的 .runs/app-server-*/models.json。
# 一次只生成 CODEX_MODEL 对应的模型；更换模型时，请核实其真实能力。
# false 表示不生成本地目录，使用 Codex 默认目录来源。
CODEX_MODEL_CATALOG_ENABLED=true
CODEX_MODEL_DISPLAY_NAME="DeepSeek Flash"
CODEX_MODEL_DESCRIPTION="DeepSeek Flash via Responses API"

# 上下文容量（token）；MAX 不填时与 CONTEXT_WINDOW 相同。
CODEX_MODEL_CONTEXT_WINDOW=1048576
CODEX_MODEL_MAX_CONTEXT_WINDOW=1048576
CODEX_MODEL_EFFECTIVE_CONTEXT_WINDOW_PERCENT=95

# 支持的输入类型、推理档位；用英文逗号分隔。
# 不支持推理档位的模型，可同时留空 REASONING_LEVELS 和 DEFAULT_REASONING_LEVEL。
CODEX_MODEL_INPUT_MODALITIES=text,image
CODEX_MODEL_SUPPORTS_IMAGE_DETAIL_ORIGINAL=true
CODEX_MODEL_REASONING_LEVELS=low,high,max
CODEX_MODEL_DEFAULT_REASONING_LEVEL=high
CODEX_MODEL_REASONING_SUMMARY=none

# 这些是模型能力声明，不代表向 Agent 授予系统权限。
CODEX_MODEL_SHELL_TYPE=unified_exec
CODEX_MODEL_APPLY_PATCH_TOOL_TYPE=freeform
CODEX_MODEL_SUPPORT_VERBOSITY=true
CODEX_MODEL_DEFAULT_VERBOSITY=low
# 工具输出截断阈值，不是模型回答的最大输出长度。
CODEX_MODEL_TOOL_OUTPUT_LIMIT=10000

# 角色正文：agents/roles/writing-assistant.md；不在 .env 中编写角色提示词。

# 可选：单个协议请求或一轮模型生成的超时时间（毫秒）；等待用户输入不计时。
DEMO_TIMEOUT_MS=180000

# 可选 RAG；Wiki 默认不需要 Chroma 或 embedding。填写后重启。
CHROMA_URL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
