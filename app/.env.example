# 复制为 .env，仅在宿主填写；不提交，不挂进长期运行的 agent。
# CONTAINER_APP_DIR 填当前部署目录的绝对路径，与宿主路径相同；以后不要更改。
CONTAINER_APP_DIR=
# 宿主 Caddy 入口端口；节点内部仍使用 4340–4342。
AGENT_PORT=4317
# 默认单节点；打开三节点集群时同时设置以下两项，再重新运行 configure：
# AGENT_CLUSTER_NODES=node-a,node-b,node-c
# COMPOSE_PROFILES=cluster
AGENT_CLUSTER_NODES=node-a
COMPOSE_PROFILES=
AGENT_DB_PASSWORD=
AGENT_GATEWAY_KEY=
CODEX_API_KEY=
CODEX_MODEL_CATALOG_ENABLED=true
CODEX_MODEL=kimi/kimi-k2.7-code
AGENT_DEFINITION=agents/writing/agent.json
AGENT_WEB_SEARCH=auto
AGENT_MAX_CONCURRENT_TURNS=2
AGENT_MAX_QUEUED=200
AGENT_RATE_LIMIT_PER_MINUTE=120
AGENT_MAX_SSE=20
POSTGRES_MEMORY_LIMIT=256m
REDIS_MEMORY_LIMIT=128m
GATEWAY_MEMORY_LIMIT=256m
AGENT_MEMORY_LIMIT=768m
NPM_REGISTRY=https://registry.npmjs.org
APT_MIRROR=
ARK_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
HUGGINGFACE_API_KEY=
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_USE=true
AGENT_MEMORY_GENERATE=true
AGENT_MEMORY_EXTRACT_MODEL=
AGENT_MEMORY_CONSOLIDATION_MODEL=
AGENT_MEMORY_MIN_IDLE_HOURS=6
AGENT_BUDGET_DAILY_TOKENS=
AGENT_BUDGET_MONTHLY_TOKENS=
AGENT_BUDGET_DAILY_COST=
AGENT_BUDGET_MONTHLY_COST=
AGENT_BUDGET_TIMEZONE=
AGENT_BUDGET_DOWNGRADE_AT=
AGENT_BUDGET_DOWNGRADE_SCENE=fast
AGENT_GATEWAY_DAILY_TOKENS=

# 节点直连开发默认 node-a:4340；CLI 入口为 Caddy:4317。
AGENT_NODE_ID=node-a
ETCD_ENDPOINT=http://127.0.0.1:2379
# 节点 A 必填；只在启用对应节点时填写 B/C 的密钥、哈希及数据库/etcd 密码。
AGENT_NODE_KEY_A=
AGENT_NODE_KEY_A_HASH=
AGENT_NODE_KEY_B=
AGENT_NODE_KEY_B_HASH=
AGENT_NODE_KEY_C=
AGENT_NODE_KEY_C_HASH=
# 接收上限，只能下调（默认 1 GiB）
AGENT_TRANSFER_MAX_BYTES=1073741824
AGENT_SHARD_STRATEGY=slots

# 三个节点分别使用独立非 superuser 角色；至少 24 位字母数字或 _-。
AGENT_NODE_A_DB_PASSWORD=
AGENT_NODE_B_DB_PASSWORD=
AGENT_NODE_C_DB_PASSWORD=

# init-env generates these secrets on the server; never share node passwords.
REDIS_PASSWORD=
ETCD_ROOT_PASSWORD=
ETCD_HEALTH_PASSWORD=
ETCD_NODE_A_PASSWORD=
ETCD_NODE_B_PASSWORD=
ETCD_NODE_C_PASSWORD=

# app replication: fixed 5s debounce / 60s idle / 300s lag warning.
AGENT_RUNTIME_LIMIT=4
# Two hosts only: retain the cluster profile and enable remote-access.
# COMPOSE_FILE=compose.yaml:deploy/two-host.compose.yaml
# COMPOSE_PROFILES=cluster,remote-access
# AGENT_NODE_ADDRESS_B=http://host.docker.internal:4341
# NODE_B_UPSTREAM=host.docker.internal:4341
# REMOTE_BRIDGE_SUBNET=172.29.18.0/24
# REMOTE_BRIDGE_GATEWAY=172.29.18.1

# Optional cluster key prefix; default /codex/. All nodes must agree; etcd ACL must cover it.
# ETCD_PREFIX=/codex/

# 两台服务器：复制 tar 总发送速率（字节/秒），建议不超过实测带宽约 70%；0 不限速，单机模拟不设置。
# AGENT_REPLICATION_RATE_LIMIT=262144
# 跨地域节点的数据库连接超时（毫秒，默认 3000）；remote-env 为第二台输出 15000。
# AGENT_DATABASE_CONNECT_TIMEOUT_MS=15000
# 同理：事务内空闲超时（默认 15000）与 etcd 单次调用超时（默认 3000），第二台分别为 60000、10000。
# AGENT_DATABASE_IDLE_TX_TIMEOUT_MS=60000
# AGENT_ETCD_RPC_TIMEOUT_MS=10000
# 连接池上限（默认 6）：跨洋时每个事务占用连接数秒，第二台为 16。
# AGENT_DATABASE_POOL_MAX=16
# Redis 建连与单条命令超时（默认 2000），第二台为 10000。
# AGENT_REDIS_TIMEOUT_MS=10000
# 请求预算（默认 30000）：转发方与接收方共用；两台模式控制机 .env 与第二台都设 120000。
# AGENT_REQUEST_TIMEOUT_MS=120000
