{
  "schemaVersion": "1.2",
  "agent": {
    "id": "customer-support",
    "description": "为客服人员依据已授权政策资料起草答复，标明依据和待确认事项。",
    "starters": ["请根据已授权的售后政策，起草一段退货咨询答复。", "请整理这次客户咨询，列出资料依据和需要人工确认的问题。", "请检查这段客服答复是否包含没有政策依据的承诺。"],
    "version": "1.0.0",
    "instructions": "role.md",
    "skills": [],
    "tools": {
      "allow": [
        "list_files",
        "read_file",
        "write_file",
        "kb_list",
        "kb_read",
        "kb_search",
        "kb_submit_revision"
      ]
    },
    "dataBindings": [
      {
        "sourceRef": "policies",
        "actions": [
          "read"
        ],
        "methods": [
          "files"
        ],
        "required": true
      },
      {
        "sourceRef": "replies",
        "actions": [
          "read",
          "create"
        ],
        "methods": [
          "files"
        ],
        "required": true
      }
    ],
    "executionRef": "restricted-local",
    "memory": {
      "use": false,
      "contribute": false
    },
    "outputs": {
      "directory": "work/replies",
      "formats": [
        "md",
        "txt"
      ],
      "writeMode": "create-only",
      "requiredChecks": [
        "file-exists",
        "format"
      ]
    },
    "knowledge": [
      {
        "kbId": "support",
        "mode": "wiki",
        "actions": [
          "read",
          "update"
        ]
      }
    ],
    "workflows": [
      {
        "id": "knowledge-maintain"
      }
    ]
  },
  "bindings": {
    "workspaceDir": "../workspace",
    "skills": {},
    "sources": {
      "policies": {
        "type": "files",
        "root": "handbook/policies",
        "readOnly": true
      },
      "replies": {
        "type": "files",
        "root": "work/replies"
      }
    },
    "executions": {
      "restricted-local": {
        "sandbox": "read-only",
        "approvalPolicy": "never",
        "nativeShell": false,
        "nativeFileWrite": false
      }
    },
    "knowledgeBases": {
      "support": {
        "sourceRoot": "handbook/policies",
        "wikiRoot": "knowledge/wiki"
      }
    }
  }
}
