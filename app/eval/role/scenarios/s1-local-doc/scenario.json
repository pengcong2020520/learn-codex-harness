{
  "id": "s1-local-doc",
  "name": "本地写文档",
  "prompt": "请根据 inputs/docs/ 下的需求说明和评审会纪要，写一份《知识库批量导入功能设计文档》，包含：背景与目标、需求范围（含不做什么）、方案设计（导入流程、去重、目录结构保留、导入报告）、里程碑、风险与待定事项。两份资料有出入的地方以评审会的最新结论为准。不需要先给我看大纲，直接写完保存到 outputs/。",
  "checks": [
    {
      "id": "deliverable",
      "label": "交付物保存在 outputs/",
      "type": "deliverable",
      "dir": "outputs"
    },
    {
      "id": "length",
      "label": "篇幅不少于 1200 字（未限定上限，超过 15000 视为失控）",
      "type": "length",
      "min": 1200,
      "max": 15000
    },
    {
      "id": "headings",
      "label": "至少 5 个章节标题",
      "type": "headings",
      "min": 5
    },
    {
      "id": "limit-500",
      "label": "单次上限采用评审结论 500 个",
      "type": "includes",
      "any": [
        "500\\s*个"
      ]
    },
    {
      "id": "docx-later",
      "label": "Word 不进首期",
      "type": "includes",
      "any": [
        "(第二期|二期|后续版本|不进首期|首期不)[^\\n]{0,40}(Word|docx)",
        "(Word|docx)[^\\n]{0,40}(第二期|二期|不进首期|首期不|后续版本)"
      ]
    },
    {
      "id": "sha256",
      "label": "去重方式为内容哈希",
      "type": "includes",
      "any": [
        "SHA-?256",
        "哈希"
      ]
    },
    {
      "id": "attachment-20mb",
      "label": "附件超过 20 MB 跳过",
      "type": "includes",
      "any": [
        "20\\s*MB"
      ]
    },
    {
      "id": "milestones",
      "label": "里程碑日期齐全",
      "type": "includes-all",
      "all": [
        "10[/月.-]\\s?20",
        "11[/月.-]\\s?10",
        "11[/月.-]\\s?17",
        "11[/月.-]\\s?24"
      ]
    },
    {
      "id": "pending",
      "label": "列出待定的创建时间问题",
      "type": "includes",
      "any": [
        "创建时间[^\\n]{0,60}(待定|待确认|未定|10[/月.-]\\s?22)",
        "(待定|待确认)[^\\n]{0,60}创建时间"
      ]
    }
  ],
  "judgeFocus": "是否以评审会的最新结论为准（上限 500、Word 放二期）；方案设计是否具体可执行（流程、去重、目录、报告、后台任务与通知）；是否忠于资料、没有编造资料里没有的需求或数据；待定事项与风险是否交代清楚。"
}
