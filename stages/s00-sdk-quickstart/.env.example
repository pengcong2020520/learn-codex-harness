# 主线使用 npx codex login 的已有登录，不需要填写 API key。
# 如需 API key 方式，把本文件复制为 .env 后在本地填写。不要分享 .env。
# CODEX_API_KEY=

# App Server 使用 API Key 时，必须同时填写服务地址和 CODEX_MODEL。
# 第三方请填写其 Responses API 基础地址，不要添加 /responses。
# CODEX_BASE_URL=https://api.openai.com/v1

# 已有登录方式可选；App Server 的 API Key 方式必填服务商支持的模型名。
# CODEX_MODEL=

# fix、resume、json 的单次调用超时；hello、app-server 固定为 3 分钟。
# 单位为毫秒。默认 180000 = 3 分钟。
# DEMO_TIMEOUT_MS=180000
