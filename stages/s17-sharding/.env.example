# 复制为 .env，仅在宿主填写；不提交，不挂进长期运行的 agent。
# CONTAINER_APP_DIR 填当前部署目录的绝对路径，与宿主路径相同；以后不要更改。
CONTAINER_APP_DIR=
AGENT_PORT=4340
AGENT_DB_PASSWORD=
AGENT_GATEWAY_KEY=
CODEX_API_KEY=
CODEX_MODEL_CATALOG_ENABLED=true
CODEX_MODEL=kimi/kimi-k2.7-code
AGENT_DEFINITION=agents/writing/agent.json
AGENT_WEB_SEARCH=auto
AGENT_MAX_CONCURRENT_TURNS=2
AGENT_MAX_QUEUED=200
AGENT_RATE_LIMIT_PER_MINUTE=120
AGENT_MAX_SSE=20
POSTGRES_MEMORY_LIMIT=256m
REDIS_MEMORY_LIMIT=128m
GATEWAY_MEMORY_LIMIT=256m
AGENT_MEMORY_LIMIT=768m
NPM_REGISTRY=https://registry.npmjs.org
APT_MIRROR=
ARK_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
HUGGINGFACE_API_KEY=
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_USE=true
AGENT_MEMORY_GENERATE=true
AGENT_MEMORY_EXTRACT_MODEL=
AGENT_MEMORY_CONSOLIDATION_MODEL=
AGENT_MEMORY_MIN_IDLE_HOURS=6
AGENT_BUDGET_DAILY_TOKENS=
AGENT_BUDGET_MONTHLY_TOKENS=
AGENT_BUDGET_DAILY_COST=
AGENT_BUDGET_MONTHLY_COST=
AGENT_BUDGET_TIMEZONE=
AGENT_BUDGET_DOWNGRADE_AT=
AGENT_BUDGET_DOWNGRADE_SCENE=fast
AGENT_GATEWAY_DAILY_TOKENS=

# 节点直连开发默认 node-a:4340；CLI 入口为 Caddy:4335。
AGENT_NODE_ID=node-a
ETCD_ENDPOINT=http://127.0.0.1:2379
# 镜像 digest 继承上一章已核实值。
AGENT_NODE_KEY=
AGENT_SHARD_STRATEGY=slots

# 三个节点分别使用独立非 superuser 角色；至少 24 位字母数字或 _-。
AGENT_NODE_A_DB_PASSWORD=
AGENT_NODE_B_DB_PASSWORD=
AGENT_NODE_C_DB_PASSWORD=

# init-env generates these secrets on the server; never share node passwords.
REDIS_PASSWORD=
ETCD_ROOT_PASSWORD=
ETCD_NODE_A_PASSWORD=
ETCD_NODE_B_PASSWORD=
ETCD_NODE_C_PASSWORD=
