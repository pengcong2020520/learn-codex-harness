{
  "name": "s15",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node client/main.mjs",
    "chat": "node client/main.mjs",
    "server": "node server/main.mjs",
    "app-server": "node server/main.mjs",
    "demo": "node 05-app-server.mjs",
    "check": "node server/check.mjs",
    "check:server": "node server/check.mjs --codex",
    "smoke": "node scripts/smoke.mjs",
    "tools": "node server/modules/tools/web-cli.mjs",
    "test:codex-tools": "node --test tests/codex-tools.integration.mjs",
    "test:codex-memory": "node --test tests/codex-memory.integration.mjs",
    "data:migrate": "node scripts/data.mjs migrate",
    "data:import": "node scripts/data.mjs import",
    "data:check": "node scripts/data.mjs check",
    "test:data": "node scripts/test-data.mjs",
    "test": "node scripts/test-offline.mjs",
    "knowledge": "node scripts/knowledge.mjs",
    "knowledge:init": "node scripts/knowledge.mjs init",
    "test:rag": "node scripts/test-data.mjs --rag",
    "agent:init": "node scripts/init-agent.mjs",
    "test:protocol": "node --test tests/protocol.integration.mjs",
    "smoke:real": "node scripts/test-data.mjs --real-smoke",
    "sessions:upgrade": "node scripts/upgrade-sessions.mjs",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose stop postgres redis",
    "gateway:key": "node scripts/gateway-config.mjs --ensure-key",
    "gateway:check": "node scripts/gateway-check.mjs",
    "gateway:config": "node scripts/gateway-config.mjs",
    "gateway:up": "node scripts/gateway-config.mjs && docker compose up -d --wait --force-recreate gateway",
    "gateway:down": "docker compose stop gateway",
    "test:gateway": "node --test --test-concurrency=1 tests/gateway.integration.mjs tests/media-gateway.integration.mjs",
    "lesson": "node lessons/run.mjs",
    "backup": "bash deploy/backup.sh",
    "restore": "bash deploy/restore.sh",
    "test:deploy": "node --test tests/deploy-*.test.mjs",
    "test:deploy:integration": "node --test tests/deploy.integration.mjs",
    "auth:init": "node scripts/accounts.mjs init",
    "user:add": "node scripts/accounts.mjs add",
    "user:passwd": "node scripts/accounts.mjs passwd",
    "user:disable": "node scripts/accounts.mjs disable",
    "user:list": "node scripts/accounts.mjs list",
    "login": "node client/auth.mjs login",
    "logout": "node client/auth.mjs logout",
    "test:auth:integration": "node --test tests/accounts.integration.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "test:ports": "node scripts/test-offline.mjs --ports",
    "accept:auth": "node scripts/accept-auth.mjs",
    "test:runtimes:pg": "node --test tests/runtimes-pg.integration.mjs",
    "test:runtimes:uid": "node --test --test-concurrency=1 tests/uid.integration.mjs tests/runtimes-uid.integration.mjs tests/runtimes-knowledge-uid.integration.mjs",
    "test:runtimes:server": "node --test tests/runtimes-server.integration.mjs",
    "hub": "node client/hub.mjs",
    "plan:assign": "node client/hub.mjs plan:assign",
    "test:hub:pg": "node --test tests/hub-pg.integration.mjs",
    "test:hub:uid": "node --test tests/hub-uid.integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.154.0",
    "ajv": "8.20.0",
    "htmlparser2": "12.0.0",
    "pg": "8.23.1",
    "redis": "6.3.0"
  },
  "optionalDependencies": {
    "chromadb": "3.5.0"
  }
}
