{
  "enabled": true,
  "module": "server/modules/tools/files.mjs",
  "tools": [
    {
      "name": "list_files", "label": "查看文件", "readOnly": true,
      "description": "列出配置工作区内获准读取的目录。省略 path 返回允许范围的入口，不递归；不显示范围外文件。",
      "inputSchema": { "type": "object", "properties": { "path": { "type": "string", "maxLength": 500 } }, "required": [], "additionalProperties": false }
    },
    {
      "name": "read_file", "label": "读取文件", "readOnly": true,
      "description": "读取配置工作区内获准来源的 .md/.txt 文件。正常服务返回 sourceId、resourceId、versionId 与内容哈希；生成派生文章时用这些 ID 声明引用。最大 256 KiB；写入权限不自动授予读取权。",
      "inputSchema": { "type": "object", "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 500, "description": "例如 inputs/观点.txt" }, "max_chars": { "type": "integer", "minimum": 1, "maximum": 40000 } }, "required": ["path"], "additionalProperties": false }
    },
    {
      "name": "write_file", "label": "保存文件", "readOnly": false,
      "description": "在 Agent 授权范围新建 .md/.txt 文件，不覆盖。若内容引用 read_file 返回的资料，应通过 source_versions 声明 resourceId/versionId；用于来源失效检查，不代表已事实核查。",
      "inputSchema": { "type": "object", "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 500, "description": "例如 drafts/article-v1.md" }, "content": { "type": "string", "maxLength": 262144 }, "source_versions": { "type": "array", "maxItems": 50, "items": { "type": "object", "properties": { "resourceId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" }, "versionId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" } }, "required": ["resourceId", "versionId"], "additionalProperties": false } } }, "required": ["path", "content"], "additionalProperties": false }
    }
  ]
}
