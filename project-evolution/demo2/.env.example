# 复制为 .env 后填写；真实密钥不放入代码或模型目录。
# 本阶段由聊天主程序读取，尚未拆分独立 HTTP 服务端。
CODEX_API_KEY=
CODEX_BASE_URL=https://api.deepseek.com
CODEX_MODEL=deepseek-flash

# 以下参数由主程序转换为本次运行的 .runs/app-server-*/models.json。
# 一次只生成 CODEX_MODEL 对应的模型；更换模型时，请核实其真实能力。
# false 表示不生成本地目录，使用 Codex 默认目录来源。
CODEX_MODEL_CATALOG_ENABLED=true
CODEX_MODEL_DISPLAY_NAME="DeepSeek Flash"
CODEX_MODEL_DESCRIPTION="DeepSeek Flash via Responses API"

# 上下文容量（token）；MAX 不填时与 CONTEXT_WINDOW 相同。
CODEX_MODEL_CONTEXT_WINDOW=1048576
CODEX_MODEL_MAX_CONTEXT_WINDOW=1048576
CODEX_MODEL_EFFECTIVE_CONTEXT_WINDOW_PERCENT=95

# 支持的输入类型、推理档位；用英文逗号分隔。
# 不支持推理档位的模型，可同时留空 REASONING_LEVELS 和 DEFAULT_REASONING_LEVEL。
CODEX_MODEL_INPUT_MODALITIES=text,image
CODEX_MODEL_SUPPORTS_IMAGE_DETAIL_ORIGINAL=true
CODEX_MODEL_REASONING_LEVELS=low,high,max
CODEX_MODEL_DEFAULT_REASONING_LEVEL=high
CODEX_MODEL_REASONING_SUMMARY=none

# 这些是模型能力声明，不代表向 Agent 授予系统权限。
CODEX_MODEL_SHELL_TYPE=disabled
CODEX_MODEL_APPLY_PATCH_TOOL_TYPE=none
CODEX_MODEL_SUPPORT_VERBOSITY=true
CODEX_MODEL_DEFAULT_VERBOSITY=low
# 工具输出截断阈值，不是模型回答的最大输出长度。
CODEX_MODEL_TOOL_OUTPUT_LIMIT=10000

# 角色统一定义在 server/modules/role/index.mjs。

# 可选：单个协议请求或一轮模型生成的超时时间（毫秒）；等待用户输入不计时。
DEMO_TIMEOUT_MS=180000
